{
  "name": "lemonade-lane-environment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build && node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "node --use-env-proxy node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build:standalone && playwright test",
    "start": "node --use-env-proxy server/start.mjs",
    "market:refresh": "node --use-env-proxy scripts/refresh-market.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}

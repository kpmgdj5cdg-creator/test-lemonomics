{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lemonomics-family",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lemonomics-family",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
